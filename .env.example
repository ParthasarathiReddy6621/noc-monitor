# Copy this file to ".env" and fill in your values.
# .env is read automatically and must NEVER be committed to GitHub.

# --- Telegram (from @BotFather and getUpdates) ---
TELEGRAM_BOT_TOKEN=123456789:AAH-your-bot-token
TELEGRAM_CHAT_ID=123456789

# --- Email (Gmail: use an App Password, not your normal password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.address@gmail.com
SMTP_PASSWORD=your-16-char-app-password
ALERT_EMAIL_FROM=your.address@gmail.com
ALERT_EMAIL_TO=your.address@gmail.com
